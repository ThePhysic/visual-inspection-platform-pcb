{
  "name": "visual-inspection-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.22.0 <25",
    "pnpm": "10.34.7"
  },
  "scripts": {
    "dev": "pnpm --filter @vip/backend... build && pnpm --parallel -r dev",
    "dev:api": "pnpm --filter @vip/backend... build && pnpm --filter @vip/api dev",
    "dev:web": "pnpm --filter @vip/backend... build && pnpm --filter @vip/web dev",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm --filter @vip/backend... build && pnpm -r typecheck",
    "test": "pnpm --filter @vip/backend... build && pnpm -r test && node --test infra/benchmark/core.test.mjs infra/real/environment.test.mjs infra/real/slow-probe.test.mjs",
    "test:integration": "pnpm --filter @vip/backend... build && pnpm --filter @vip/api test:integration",
    "build": "pnpm -r build",
    "dev:worker": "pnpm --filter @vip/backend... build && pnpm --filter @vip/worker dev",
    "test:e2e": "pnpm build && pnpm --filter @vip/web test:e2e",
    "test:reliability": "node infra/docker/test-reliability.mjs",
    "test:real": "node infra/real/run.mjs",
    "test:real:smoke": "node infra/real/smoke.mjs",
    "test:ci:integration": "node infra/docker/test-native.mjs",
    "storage:maintenance": "node infra/docker/storage-maintenance.mjs",
    "benchmark": "node infra/benchmark/run.mjs",
    "portfolio:capture": "node infra/portfolio/capture.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
